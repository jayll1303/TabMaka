{
  "manifest_version": 3,
  "name": "TabMaka - Cozy New Tab Pet",
  "version": "0.2.2",
  "description": "An adorable cozy pet that greets you on every new tab. 100% local, no tracking.",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": ["storage", "tabs"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
